    "launcher": ">=1.9.0"
  },
  "requires": [
    {
      "id": "swofty.core",
      "version": ">=0.1.0"
    }
  ],
  "experimental_features": [
    "telemetry"
  ],
  "operations": {
    "hud": [
      "registry/hud.json"
    ],
    "native": [
      {
        "dll": "native/halo_hud_v2.dll"
      },
      {
        "dll": "native/sector_times.dll"
      }
    ]
  }
}

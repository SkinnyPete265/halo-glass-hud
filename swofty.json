{
  "schema_version": 1,
  "id": "local.halo-hud-v2",
  "name": "Halo Glass HUD v2 (Beta)",
  "version": "0.15.0-beta.1",
  "author": "Local HUD project",
  "description": "A glass-style racing HUD for the 2025 and 2026 F1 dials, with speed, gears, energy, and sector times.",
